<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the Unity-free ad logic and its NUnit tests without opening Unity:
      dotnet test NativeAds/logic-tests
    LangVersion matches Unity 2022.3 so nothing newer slips into the SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/FlyingAcorn/Soil/Advertisement/Logic/**/*.cs" />
    <Compile Include="../../Assets/FlyingAcorn/Soil/Advertisement/Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
